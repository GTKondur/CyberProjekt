{
  "kind": "api",
  "name": "DummyJSON API",
  "base_url": "https://dummyjson.com",
  "requests": {
    "timeout_seconds": 10,
    "max_response_seconds": 3,
    "user_list_limit": 5
  },
  "endpoints": {
    "users": "/users",
    "user_by_id": "/users/1",
    "missing_user": "/users/99999",
    "login": "/auth/login",
    "current_user": "/auth/me"
  },
  "credentials": {
    "username": "emilys",
    "password": "emilyspass"
  },
  "invalid_password": "incorrect",
  "invalid_token": "invalid-token",
  "expected": {
    "success_status": 200,
    "not_found_status": 404,
    "unauthorized_statuses": [401, 403],
    "invalid_login_statuses": [400, 401],
    "user_id": 1,
    "username": "emilys"
  }
}
